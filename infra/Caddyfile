(estado) {
	redir /estado /estado/ 308
	handle_path /estado/* {
		root * /srv/estado
		header /estado.json Cache-Control "no-store"
		file_server
	}
}

{$DOMAIN} {
	encode gzip
	import estado
	handle {
		reverse_proxy ucopet-main-front:80
	}
}

{$DOMAIN}:8443 {
	encode gzip
	import estado
	handle {
		reverse_proxy ucopet-develop-front:80
	}
}

{$DOMAIN}:9443 {
	encode gzip
	import estado
	handle {
		reverse_proxy ucopet-pruebas-front:80
	}
}

{$DOMAIN}:15671 {
	reverse_proxy rabbit:15672
}
