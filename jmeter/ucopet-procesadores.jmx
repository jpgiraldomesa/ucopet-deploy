<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
<hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="UcoPet - Todos los procesadores" enabled="true"><stringProp name="TestPlan.comments">Un grupo de hilos por procesador, todos a la vez. Propiedades: -Jhost, -Jpuerto (9443 pruebas, 8443 develop), -Jcorreo, -Jclave, -Jhilos (por procesador), -Jminutos, -Jrun (id para borrar luego con scripts/carga.sh fin &lt;entorno&gt; &lt;run&gt; todos).</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp></TestPlan><hashTree><ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Servidor (pruebas por defecto)" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.protocol">https</stringProp><stringProp name="HTTPSampler.domain">${__P(host,ucopet.westus2.cloudapp.azure.com)}</stringProp><stringProp name="HTTPSampler.port">${__P(puerto,9443)}</stringProp><stringProp name="HTTPSampler.connect_timeout">10000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></ConfigTestElement><hashTree/><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Preparacion: iniciar sesion y tomar datos" enabled="true"><stringProp name="Thr